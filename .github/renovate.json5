// Renovate configuration. Renovate proposes upgrades as pull requests, in
// the same way Dependabot does; see .github/dependabot.yml.
//
// Copyright the Linux Foundation and the OpenSSF Best Practices badge
// contributors
// SPDX-License-Identifier: MIT
//
// WHY BOTH TOOLS. They cover different ground and must not overlap.
// Dependabot handles the Gemfile, npm and GitHub Actions workflows. It
// cannot read .circleci/config.yml at all: dependabot-core carries one
// directory per ecosystem, 43 of them, and there is no "circleci" among
// them. Its "docker" ecosystem reads Dockerfiles, not CI configurations.
// Renovate does have a circleci manager, and that is the only reason it
// is here.
//
// So this file scopes Renovate to exactly that. At its defaults it would
// also read the Gemfile, .ruby-version and Dockerfiles, where it would
// compete with Dependabot and pre-empt the Ruby design recorded in
// docs/build-environment-staleness.md.
//
// This is written as JSON5 rather than JSON so the reasoning can sit
// beside the rules instead of in a file nobody opens.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // The whole point, and the whole scope.
  enabledManagers: ['circleci'],

  // A single issue listing everything Renovate can see, including
  // anything it has decided not to propose. Without it, "no pull
  // request" and "nothing to update" look identical.
  dependencyDashboard: true,

  labels: ['dependencies'],

  // ONE PULL REQUEST PER DEPENDENCY, which is Renovate's default and is
  // relied on here rather than configured. Nothing sets "groupName", and
  // there is no "extends", so no preset quietly groups things either. So
  // a stack upgrade arrives on its own, to be judged on its own, even if
  // PostgreSQL and Chrome happen to have updates the same week. The two
  // heroku/heroku pins are one dependency and do share a pull request,
  // which is what we want: they must move together.
  //
  // The default hourly limit is 2, which would be wrong here. This runs
  // weekly, from a workflow that starts, does its work and exits, so a
  // limit of 2 means two proposals a week and the rest waiting for the
  // next run: a stack upgrade could sit behind routine bumps for weeks
  // without anything saying so. Zero means no limit.
  prHourlyLimit: 0,

  // No schedule here on purpose. How often Renovate runs is decided by
  // the cron in .github/workflows/renovate.yml, so there is one place to
  // change the cadence rather than two that can disagree.

  packageRules: [
    {
      description: [
        'heroku/heroku is the stack, and the stack is deliberately one',
        'decision rather than two. The tag in .circleci/config.yml is',
        'the single source of truth: CI derives the stack from',
        'CNB_STACK_ID inside that image, carries it to the deploy job',
        'through the workspace, and the deploy job sets the Heroku',
        "applications' stack to match. So accepting a pull request that",
        'moves 24-build to 26-build runs the whole suite on heroku-26,',
        'and, if it passes and reaches staging, moves staging onto',
        'heroku-26. Production follows by the same route.',
        '',
        'That is why this proposal is WANTED rather than suppressed, and',
        'why it deserves more thought than a routine bump: it is plan',
        'step 10 arriving as a pull request.',
        '',
        'Note the image is pinned TWICE, in the ruby-postgres and',
        'ruby-only executors, and both must move together or the static',
        'job and the test job stop checking the same environment.',
      ],
      matchDatasources: ['docker'],
      matchPackageNames: ['heroku/heroku'],
      labels: ['dependencies', 'stack-upgrade'],
      prBodyNotes: [
        '> **This changes the operating system everything runs on.**',
        '>',
        '> Merging it moves the test environment to the new stack. When',
        '> it reaches `staging`, the deploy job sets that application to',
        '> the same stack and rebuilds; `production` follows when it is',
        '> advanced. Maintenance mode is taken automatically for a stack',
        '> change.',
        '>',
        '> Rolling back means reverting this pull request and letting a',
        '> full deploy move the stack back.',
      ],
    },
  ],
}
