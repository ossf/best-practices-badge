// Renovate configuration. Renovate proposes upgrades as pull requests, in
// the same way Dependabot does; see .github/dependabot.yml.
//
// Copyright the Linux Foundation and the OpenSSF Best Practices badge
// contributors
// SPDX-License-Identifier: MIT
//
// WHY BOTH TOOLS. They cover different ground and must not overlap.
// Dependabot handles the Gemfile, npm and GitHub Actions workflows. It
// cannot read .circleci/config.yml at all: dependabot-core carries one
// directory per ecosystem, 43 of them, and there is no "circleci" among
// them. Its "docker" ecosystem reads Dockerfiles, not CI configurations.
// Nor does Dependabot update Ruby itself: its issue 2254 asks for
// exactly that and has been open since 2018.
//
// Renovate covers both gaps, and this file scopes it to those two and
// nothing else: the CircleCI images, and .ruby-version together with
// the Ruby line in Gemfile.lock. At its defaults it would also read the
// Gemfile and the Dockerfiles, where it would compete with Dependabot.
//
// This is written as JSON5 rather than JSON so the reasoning can sit
// beside the rules instead of in a file nobody opens.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // The scope. "circleci" is the manager Dependabot lacks;
  // "custom.regex" is the one below that keeps .ruby-version moving.
  // Naming them explicitly is what keeps Renovate off the Gemfile and
  // the Dockerfiles, where it would compete with Dependabot.
  enabledManagers: ['circleci', 'custom.regex'],

  // RUBY, FROM WHAT HEROKU HAS RATHER THAN WHAT RUBY RELEASED.
  //
  // Renovate's own ruby-version datasource knows what Ruby RELEASED;
  // what matters is what Heroku BUILT for our stack, which lags it. A
  // proposal for a Ruby Heroku lacks is red on arrival and sits there
  // teaching people to disregard red.
  //
  // No machine-readable list of that exists: the devcenter names
  // versions in prose without saying which stack each is for, and
  // heroku/buildpacks-ruby has no inventory file. So
  // .github/workflows/heroku_ruby_versions.yml probes weekly, as
  // Heroku's own buildpack does, and commits the answer.
  //
  // "file://" is read with readLocalFile, relative to the repository
  // CLONE, which is why the file is committed rather than written into
  // a runner's workspace. Format "plain" is one release per line, what
  // script/heroku_ruby_versions prints.
  customDatasources: {
    'heroku-ruby': {
      defaultRegistryUrlTemplate: 'file://.github/heroku-ruby-versions.txt',
      format: 'plain',
    },
  },

  // TWO FILES, ONE DECISION. Heroku installs the Ruby named in
  // Gemfile.lock, not .ruby-version, so changing only the latter passes
  // every test here and installs the old interpreter on deploy.
  // Matching both from one manager moves them in one pull request;
  // rake ruby_version_matches_lock fails the build if they diverge.
  //
  // THE LOCK'S MATCH STOPS BEFORE BUNDLER'S "p0". Capturing "3.4.1p0"
  // whole would replace the patchlevel too, but Gem::Version reads a
  // letter as a PRERELEASE marker, so Renovate would skip that
  // occurrence under ignoreUnstable. Digits only leaves "ruby
  // 3.4.10p0": version right, patchlevel stale until the next bundle
  // install rewrites it. Nothing reads the patchlevel to choose an
  // interpreter, and inventing a number we cannot know without running
  // the new Ruby would be worse than an obviously stale one.
  //
  // THE VERSION IS "[\d.]+", the shape rake ruby_version_matches_lock
  // already reads out of the lock, rather than a spelled out
  // "\d+\.\d+\.\d+". Ruby has shipped no X.Y.Z.W yet, but the shape
  // exists for a sub-patch release and would arrive unannounced, and
  // one forgiving character class is cheaper than a component count
  // kept in step in three files. It still stops before "p0", "p"
  // being neither a digit nor a dot.
  //
  // PRERELEASES STAY OUT, and stay out SAFELY, which is the argument
  // for this shape over the spelled out one. A .ruby-version of
  // "3.4.0-preview1" matches nothing, the "-" falling outside the
  // class, and rake renovate_patterns_match reports that dead pattern
  // instead of leaving it to be noticed later. In the lock, "ruby
  // 3.4.0.preview1" yields "3.4.0." WITH the trailing dot, which
  // Gem::Version rejects outright, so Renovate has no version to
  // compare and proposes nothing. "\d+\.\d+\.\d+" would instead
  // capture a clean "3.4.0" there and rewrite just that, leaving
  // "ruby 3.4.10.preview1" behind. Unparseable is the better failure.
  //
  // THE LOCK'S PATTERN ANCHORS ON "RUBY VERSION", NOT ON "^".
  // Renovate compiles every matchString with the "g" flag and nothing
  // else, in lib/modules/manager/custom/regex/strategies.ts, so "^" is
  // the start of the FILE and not of a line. The .ruby-version pattern
  // below survives that only because that file begins with the version.
  // An "^\s+ruby" pattern can never match Gemfile.lock, which begins
  // with "GEM", and a matchString that matches nothing says nothing:
  // pull request 2941 duly changed .ruby-version alone, and it was rake
  // ruby_version_matches_lock that caught it, not anything here.
  //
  // Anchoring on the literal stanza header needs no anchor at all, and
  // cannot wander onto some other indented "ruby" line. "(?m)" would
  // also work, but only while Renovate runs with RE2 loaded: native
  // JavaScript rejects an inline flag group outright, so that fix would
  // depend on which regex engine happened to be present.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^\\.ruby-version$/', '/^Gemfile\\.lock$/'],
      matchStrings: [
        '^(?<currentValue>[\\d.]+)\\s*$',
        'RUBY VERSION\\s+ruby (?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'ruby',
      datasourceTemplate: 'custom.heroku-ruby',
      versioningTemplate: 'ruby',
    },
  ],

  // ONE PULL REQUEST PER LINE: the gems above us can take weeks to be
  // ready for a new minor or major, and the routine patch bump should
  // not wait behind that argument. Renovate does this natively.
  separateMinorPatch: true,
  separateMultipleMajor: true,

  // A single issue listing everything Renovate can see, including
  // anything it has decided not to propose. Without it, "no pull
  // request" and "nothing to update" look identical.
  dependencyDashboard: true,

  labels: ['dependencies'],

  // ONE PULL REQUEST PER DEPENDENCY, which is Renovate's default and is
  // relied on here rather than configured. Nothing sets "groupName", and
  // there is no "extends", so no preset quietly groups things either. So
  // a stack upgrade arrives on its own, to be judged on its own, even if
  // PostgreSQL and Chrome happen to have updates the same week. The two
  // heroku/heroku pins are one dependency and do share a pull request,
  // which is what we want: they must move together.
  //
  // The default hourly limit is 2, which would be wrong here. This runs
  // weekly, from a workflow that starts, does its work and exits, so a
  // limit of 2 means two proposals a week and the rest waiting for the
  // next run: a stack upgrade could sit behind routine bumps for weeks
  // without anything saying so. Zero means no limit.
  prHourlyLimit: 0,

  // A REJECTED PROPOSAL STAYS REJECTED. Close a pull request without
  // merging and Renovate will not open it again for that same version.
  // A NEWER version is a new question and does get asked: close the
  // 1.9.9 proposal and 1.9.10 may still arrive. "auto" is the default,
  // and is written out because relying on a default for behaviour this
  // visible means a future change to it would surprise us quietly.
  //
  // While a pull request is OPEN, Renovate updates that same branch
  // rather than opening a second one; branch names are derived from the
  // dependency, so duplicates cannot pile up.
  //
  // The consequence to know: closing a proposal removes it from the
  // pull request list, which is where this project keeps the decisions
  // waiting for a human. The dependency dashboard above is what stops
  // that being a silent forget. It lists what Renovate could propose
  // and is not proposing, including anything closed, with a checkbox to
  // ask again.
  recreateWhen: 'auto',

  // A PROPOSAL IS REBUILT WHEN main MOVES UNDER IT. A pull request that
  // sits for weeks, which is what a stack upgrade does while the
  // libraries above it catch up, otherwise keeps showing green checks
  // earned against a main that no longer exists. The default,
  // "conflicted", rebases only when git cannot merge: two changes can
  // be perfectly mergeable and never tested together, and
  // .ruby-version and the stack tag are that pair.
  //
  // THE COST IS BOUNDED BY THE CRON, not by how busy main is, because
  // we self-host: six weeks open means six rebuilds, not one per push.
  // The hosted App reacting to webhooks would bill differently.
  //
  // Deliberately NOT "require branches to be up to date before
  // merging", which would impose the same ceremony on every human pull
  // request; main, staging and production each re-run the full suite
  // anyway. This keeps the PROPOSAL honest rather than policing all.
  rebaseWhen: 'behind-base-branch',

  // No schedule here on purpose. How often Renovate runs is decided by
  // the cron in .github/workflows/renovate.yml, so there is one place to
  // change the cadence rather than two that can disagree.

  packageRules: [
    {
      description: [
        'heroku/heroku is the stack, and the stack is deliberately one',
        'decision rather than two. The tag in .circleci/config.yml is',
        'the single source of truth: CI derives the stack from',
        'CNB_STACK_ID inside that image, carries it to the deploy job',
        'through the workspace, and the deploy job sets the Heroku',
        "applications' stack to match. So accepting a pull request that",
        'moves 24-build to 26-build runs the whole suite on heroku-26,',
        'and, if it passes and reaches staging, moves staging onto',
        'heroku-26. Production follows by the same route.',
        '',
        'That is why this proposal is WANTED rather than suppressed, and',
        'why it deserves more thought than a routine bump: it is plan',
        'step 10 arriving as a pull request.',
        '',
        'Note the image is pinned TWICE, in the ruby-postgres and',
        'ruby-only executors, and both must move together or the static',
        'job and the test job stop checking the same environment.',
      ],
      matchDatasources: ['docker'],
      matchPackageNames: ['heroku/heroku'],
      labels: ['dependencies', 'stack-upgrade'],
      prBodyNotes: [
        '> **This changes the operating system everything runs on.**',
        '>',
        '> Merging it moves the test environment to the new stack. When',
        '> it reaches `staging`, the deploy job sets that application to',
        '> the same stack and rebuilds; `production` follows when it is',
        '> advanced. Maintenance mode is taken automatically for a stack',
        '> change.',
        '>',
        '> Rolling back means reverting this pull request and letting a',
        '> full deploy move the stack back.',
      ],
    },
    {
      description: [
        'cimg/node IS NOT THE APPLICATION\'S NODE, and the rule here',
        'follows from that. It is used once, by the deploy-only',
        'executor, for the one job that pushes to Heroku. That job runs',
        'no Ruby and compiles no assets; its Node exists to install and',
        'run the Heroku CLI (at the time of this writing',
        'its only requirement is node >= 20).',
        '',
        'What the application runs is instead decided by package.json',
        '"engines": {"node": ...}, which the heroku/nodejs buildpack',
        'reads when it builds the slug on the dyno. So moving this',
        'image cannot put CI out of step with production, because it',
        'was never in step with it. See the comment beside the image in',
        '.circleci/config.yml, which says the same from the other end.',
        '',
        'USES ONLY EVEN MAJORS, because odd numbered Node lines are never',
        'promoted to LTS. That is a fixed property of Node\'s release',
        'schedule and not a "not yet", which is why this forbids them',
        'outright rather than parking them for a human: there is no',
        'future in which we want node 25 here. Even majors still',
        'arrive as proposals, to be taken whenever convenient.',
      ],
      matchDatasources: ['docker'],
      matchPackageNames: ['cimg/node'],
      allowedVersions: '/^\\d*[02468]\\./',
    },
    {
      description: [
        'cimg/postgres IS THE TEST DATABASE, not the real one. Merging',
        'this only moves what CI proves the app works against; it does',
        'not touch staging or production, which have real data and real',
        'downtime. Those are moved deliberately, afterward, with',
        'script/upgrade_postgres_version, which is the whole reason for',
        'the note below: the person merging this is exactly the person',
        'who needs to know a second, manual step still follows.',
        '',
        'Scoped to matchUpdateTypes: major, since a routine patch (16.14',
        'to 16.15) needs no such reminder; only a major version change is',
        'what that script exists for.',
      ],
      matchDatasources: ['docker'],
      matchPackageNames: ['cimg/postgres'],
      matchUpdateTypes: ['major'],
      labels: ['dependencies', 'postgres-upgrade'],
      prBodyNotes: [
        '> **This moves the CI test database only, not staging or',
        '> production.**',
        '>',
        '> Once this is merged and CI is green on PostgreSQL',
        '> {{{newMajor}}}, run `script/upgrade_postgres_version',
        '> {{{newMajor}}}` to actually move staging\'s and production\'s',
        '> real databases (staging first, then production, each proven',
        '> before the next). See that script\'s own header comment for',
        '> how it works, and `script/gather_postgres_state` for',
        '> read-only diagnostics if anything looks wrong along the way.',
      ],
    },
  ],
}
